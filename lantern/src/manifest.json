{
  "package": "com.halvamazd.lantern2",
  "name": "彩灯",
  "versionName": "1.7.1",
  "versionCode": 14,
  "minPlatformVersion": 1000,
  "icon": "/common/images/logo.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.vibrator" },
    { "name": "system.brightness" },
    { "name": "system.router" }
  ],
  "config": { "logLevel": "log", "designWidth": 336 },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index", "launchMode": "singleTask" },
      "pages/settings": { "component": "settings", "launchMode": "singleTask" },
      "pages/brightness": { "component": "brightness", "launchMode": "singleTask" },
      "pages/about": { "component": "about", "launchMode": "singleTask" },
      "pages/color": { "component": "color", "launchMode": "singleTask", "disableSwipeBack": true }
    }
  },
  "display": { "backgroundColor": "#000000" }
}