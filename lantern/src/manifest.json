        "launchMode": "singleTask"
      },
      "pages/about": {
        "component": "about",
        "launchMode": "singleTask"
      },
      "pages/color": {
        "component": "color",
        "launchMode": "singleTask"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}