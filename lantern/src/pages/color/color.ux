<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="wrap" style="left: {{shift}}px;">
      <text class="title">自定义颜色</text>
      <text class="big">敬请期待</text>
      <text class="note">下个版本开发中</text>
    </div>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }
  .wrap {
    position: absolute;
    top: 0;
    width: 336px;
    height: 480px;
  }
  .title {
    position: absolute;
    left: 0;
    top: 40px;
    width: 336px;
    text-align: center;
    color: #ffffff;
    font-size: 24px;
  }
  .big {
    position: absolute;
    left: 0;
    top: 180px;
    width: 336px;
    text-align: center;
    color: #FFD166;
    font-size: 32px;
  }
  .note {
    position: absolute;
    left: 0;
    top: 250px;
    width: 336px;
    text-align: center;
    color: #8a8a8a;
    font-size: 16px;
  }
</style>

<script>
  import router from '@system.router';

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  export default {
    private: {
      shift: 336
    },
    onInit() {
      this._sx = 0;
      this._sy = 0;
      this._leaving = false;
      var that = this;
      setTimeout(function () {
        var t0 = Date.now();
        var step = function () {
          var p = (Date.now() - t0) / 300;
          if (p > 1) { p = 1; }
          that.shift = 336 * (1 - easeOut(p));
          if (p < 1) { that._inT = setTimeout(step, 16); }
        };
        step();
      }, 30);
    },
    onDestroy() {
      try {
        if (this._inT) { clearTimeout(this._inT); }
        if (this._outT) { clearTimeout(this._outT); }
      } catch (e) {}
    },
    onTouchStart(e) {
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
    },
    onTouchEnd(e) {
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        this.backAnimated();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    backAnimated() {
      if (this._leaving) { return; }
      this._leaving = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        try {
          var p = (Date.now() - t0) / 260;
          if (p > 1) { p = 1; }
          that.shift = 336 * easeOut(p);
          if (p < 1) {
            that._outT = setTimeout(step, 16);
          } else {
            router.back();
          }
        } catch (e) {
          router.back();
        }
      };
      step();
    }
  };
</script>