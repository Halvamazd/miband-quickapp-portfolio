<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <text class="title">自定义颜色</text>
    <text class="big">敬请期待</text>
    <text class="note">下个版本开发中</text>
    <text class="backTip">← 左滑返回</text>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
    align-items: center;
  }
  .title {
    position: absolute;
    left: 0;
    top: 40px;
    width: 336px;
    text-align: center;
    color: #ffffff;
    font-size: 22px;
  }
  .big {
    position: absolute;
    left: 0;
    top: 180px;
    width: 336px;
    text-align: center;
    color: #FFD166;
    font-size: 30px;
  }
  .note {
    position: absolute;
    left: 0;
    top: 250px;
    width: 336px;
    text-align: center;
    color: #8a8a8a;
    font-size: 15px;
  }
  .backTip {
    position: absolute;
    left: 0;
    top: 448px;
    width: 336px;
    text-align: center;
    color: #6a6a6a;
    font-size: 13px;
  }
</style>

<script>
  import router from '@system.router';

  export default {
    onInit() {
      this._sx = 0;
      this._sy = 0;
    },
    onTouchStart(e) {
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
    },
    onTouchEnd(e) {
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        router.back();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    }
  };
</script>