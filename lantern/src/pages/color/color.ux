<template>
  <div class="root" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <div class="wrap" style="left: {{shift}}px;">
      <text class="title">自定义颜色</text>
      <image class="wheel" src="/common/images/wheel.png"></image>
      <div class="preview" style="background-color: {{color}};" onclick="confirm"></div>
      <div class="thumb" style="left: {{tx}}px; top: {{ty}}px;"></div>
      <div class="btn" onclick="back"><text class="btnText">返回</text></div>
    </div>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }
  .wrap {
    position: absolute;
    top: 0;
    width: 336px;
    height: 480px;
  }
  .title {
    position: absolute;
    left: 0;
    top: 28px;
    width: 336px;
    text-align: center;
    color: #ffffff;
    font-size: 24px;
  }
  .wheel {
    position: absolute;
    left: 38px;
    top: 78px;
    width: 260px;
    height: 260px;
  }
  .preview {
    position: absolute;
    left: 132px;
    top: 192px;
    width: 72px;
    height: 72px;
    border-radius: 36px;
  }
  .thumb {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #ffffff;
  }
  .btn {
    position: absolute;
    left: 68px;
    top: 386px;
    width: 200px;
    height: 54px;
    border-radius: 27px;
    background-color: #3a3a3a;
    align-items: center;
    justify-content: center;
  }
  .btnText {
    color: #ffffff;
    font-size: 22px;
  }
</style>

<script>
  import router from '@system.router';
  import vibrator from '@system.vibrator';
  import state from '../../common/state.js';

  var CX = 168;
  var CY = 208;
  var RING = 130;

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  function hex2(n) {
    var s = n.toString(16);
    if (s.length < 2) { s = '0' + s; }
    return s;
  }

  function hsl(h, s, l) {
    h = h % 360;
    if (h < 0) { h += 360; }
    s = s / 100;
    l = l / 100;
    var c = (1 - Math.abs(2 * l - 1)) * s;
    var x = c * (1 - Math.abs((h / 60) % 2 - 1));
    var m = l - c / 2;
    var r = 0, g = 0, b = 0;
    if (h < 60) { r = c; g = x; }
    else if (h < 120) { r = x; g = c; }
    else if (h < 180) { g = c; b = x; }
    else if (h < 240) { g = x; b = c; }
    else if (h < 300) { r = x; b = c; }
    else { r = c; b = x; }
    return '#' + hex2(Math.round((r + m) * 255)) + hex2(Math.round((g + m) * 255)) + hex2(Math.round((b + m) * 255));
  }

  export default {
    private: {
      shift: 336,
      hue: 0,
      color: '#ffd166',
      tx: 168,
      ty: 208
    },
    onInit() {
      this._sx = 0;
      this._sy = 0;
      this._drag = false;
      this._done = false;
      var that = this;
      setTimeout(function () {
        that.slideIn();
        that.setHue(state.lastHue || 0);
      }, 30);
    },
    slideIn() {
      var that = this;
      var t0 = Date.now();
      var step = function () {
        var p = (Date.now() - t0) / 300;
        if (p > 1) { p = 1; }
        that.shift = 336 * (1 - easeOut(p));
        if (p < 1) { that._inT = setTimeout(step, 16); }
      };
      step();
    },
    onDestroy() {
      try {
        if (this._inT) { clearTimeout(this._inT); }
        if (this._outT) { clearTimeout(this._outT); }
      } catch (e) {}
    },
    setHue(h) {
      h = h % 360;
      if (h < 0) { h += 360; }
      this.hue = h;
      this.color = hsl(h, 90, 57);
      var rad = h * Math.PI / 180;
      this.tx = CX + Math.cos(rad) * RING - 11;
      this.ty = CY + Math.sin(rad) * RING - 11;
    },
    onTouchStart(e) {
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
      var dx = p.clientX - CX;
      var dy = p.clientY - CY;
      var d = Math.sqrt(dx * dx + dy * dy);
      if (d >= RING - 45 && d <= RING + 35) {
        this._drag = true;
        this.pick(p.clientX, p.clientY);
      }
    },
    onTouchMove(e) {
      if (!this._drag) { return; }
      var p = this.getPoint(e);
      this.pick(p.clientX, p.clientY);
    },
    onTouchEnd() {
      if (this._drag) { this._drag = false; }
    },
    pick(x, y) {
      var dx = x - CX;
      var dy = y - CY;
      var deg = Math.atan2(dy, dx) * 180 / Math.PI;
      this.setHue(deg);
      state.lastHue = this.hue;
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    back() {
      if (this._done) { return; }
      this._done = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        var p = (Date.now() - t0) / 260;
        if (p > 1) { p = 1; }
        that.shift = 336 * easeOut(p);
        if (p < 1) {
          that._outT = setTimeout(step, 16);
        } else {
          router.back();
        }
      };
      step();
    },
    confirm() {
      if (this._done) { return; }
      this._done = true;
      try { vibrator.vibrate({ mode: 'short' }); } catch (e) {}
      state.pendingColor = this.color;
      router.push({ uri: '/pages/index' });
    }
  };
</script>