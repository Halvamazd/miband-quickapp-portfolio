<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="titleBar" style="left: {{titleX}}px; top: 52px;">
      <div class="titleInner"><text class="title">设置</text></div>
    </div>
    <div class="row" style="left: {{x0}}px; top: 132px;" onclick="goColor">
      <div class="rowInner"><text class="rowLabel">自定义颜色</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x1}}px; top: 206px;" onclick="goBright">
      <div class="rowInner"><text class="rowLabel">屏幕亮度</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x2}}px; top: 280px;" onclick="toggleKeep">
      <div class="rowInner">
        <text class="rowLabel">屏幕常亮</text>
        <div class="track" style="background-color: {{swBg}};"><div class="dot" style="left: {{swDotX}}px;"></div></div>
      </div>
    </div>
    <div class="row" style="left: {{x3}}px; top: 354px;" onclick="goAbout">
      <div class="rowInner"><text class="rowLabel">关于</text><text class="rowArrow">›</text></div>
    </div>
    <text if="{{msg}}" class="msg">{{msg}}</text>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
  }
  .titleBar {
    position: absolute;
    width: 336px;
    height: 48px;
  }
  .titleInner {
    width: 336px;
    height: 48px;
    align-items: center;
    justify-content: center;
  }
  .title {
    color: #ffffff;
    font-size: 26px;
  }
  .row {
    position: absolute;
    width: 336px;
    height: 64px;
    align-items: center;
    justify-content: center;
  }
  .rowInner {
    width: 292px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .rowLabel {
    color: #ffffff;
    font-size: 24px;
  }
  .rowArrow {
    color: #9a9a9a;
    font-size: 30px;
  }
  .track {
    position: relative;
    width: 68px;
    height: 36px;
    border-radius: 18px;
  }
  .dot {
    position: absolute;
    top: 3px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #ffffff;
  }
  .msg {
    position: absolute;
    left: 0;
    top: 430px;
    width: 336px;
    text-align: center;
    color: #ff6b6b;
    font-size: 15px;
  }
</style>

<script>
  import router from '@system.router';
  import brightness from '@system.brightness';

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  export default {
    private: {
      titleX: -336,
      x0: 336,
      x1: 336,
      x2: 336,
      x3: 336,
      keepOn: true,
      swBg: '#34C759',
      swDotX: 35,
      msg: ''
    },
    onInit() {
      this._sx = 0;
      this._sy = 0;
      this._nav = false;
      this._leaving = false;
      var that = this;
      setTimeout(function () { that.startList(); }, 30);
      this.defaultKeepOn();
    },
    onShow() {
      this._nav = false;
      this._leaving = false;
    },
    onDestroy() {
      this.keepOff();
      this.clearTimers();
    },
    clearTimers() {
      try {
        if (this._listT) { clearTimeout(this._listT); this._listT = null; }
        if (this._backT) { clearTimeout(this._backT); this._backT = null; }
      } catch (e) {}
    },
    defaultKeepOn() {
      var that = this;
      try {
        brightness.setKeepScreenOn({
          keepScreenOn: true,
          success: function () {
            that.keepOn = true;
            that.swBg = '#34C759';
            that.swDotX = 35;
          },
          fail: function () {
            that.keepOn = false;
            that.swBg = '#4A4A4A';
            that.swDotX = 3;
          }
        });
      } catch (e) {
        this.keepOn = false;
        this.swBg = '#4A4A4A';
        this.swDotX = 3;
      }
    },
    onTouchStart(e) {
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
    },
    onTouchEnd(e) {
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        this.backAnimated();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    startList() {
      var that = this;
      this.titleX = -336;
      this.x0 = 336;
      this.x1 = 336;
      this.x2 = 336;
      this.x3 = 336;
      var t0 = Date.now();
      var step = function () {
        try {
          var t = Date.now() - t0;
          var all = true;
          var tp = t / 320;
          if (tp > 1) { tp = 1; }
          that.titleX = -336 * (1 - easeOut(tp));
          if (tp < 1) { all = false; }
          var starts = [140, 210, 280, 350];
          for (var i = 0; i < 4; i++) {
            var p = (t - starts[i]) / 280;
            if (p < 0) { p = 0; }
            if (p > 1) { p = 1; }
            var x = 336 * (1 - easeOut(p));
            if (i === 0) { that.x0 = x; }
            if (i === 1) { that.x1 = x; }
            if (i === 2) { that.x2 = x; }
            if (i === 3) { that.x3 = x; }
            if (p < 1) { all = false; }
          }
          if (!all) { that._listT = setTimeout(step, 16); }
        } catch (e) {}
      };
      step();
    },
    backAnimated() {
      if (this._leaving) { return; }
      this._leaving = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        try {
          var t = Date.now() - t0;
          var p = t / 280;
          if (p > 1) { p = 1; }
          var e = easeOut(p);
          that.titleX = -336 * e;
          that.x0 = 336 * e;
          that.x1 = 336 * e;
          that.x2 = 336 * e;
          that.x3 = 336 * e;
          if (p < 1) {
            that._backT = setTimeout(step, 16);
          } else {
            router.back();
          }
        } catch (err) {
          router.back();
        }
      };
      step();
    },
    goColor() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/color' });
    },
    goBright() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/brightness' });
    },
    goAbout() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/about' });
    },
    toggleKeep() {
      var that = this;
      var target = !this.keepOn;
      try {
        brightness.setKeepScreenOn({
          keepScreenOn: target,
          success: function () {
            that.keepOn = target;
            that.swBg = target ? '#34C759' : '#4A4A4A';
            that.swDotX = target ? 35 : 3;
            that.msg = '';
          },
          fail: function () {
            that.msg = '常亮接口不可用';
          }
        });
      } catch (e) {
        this.msg = '常亮接口不可用';
      }
    },
    keepOff() {
      if (!this.keepOn) { return; }
      this.keepOn = false;
      try {
        brightness.setKeepScreenOn({ keepScreenOn: false, success: function () {}, fail: function () {} });
      } catch (e) {}
    }
  };
</script>