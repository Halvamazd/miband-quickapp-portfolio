<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="titleBar" style="left: {{titleX}}px; top: 44px;">
      <div class="titleInner"><text class="title">设置</text></div>
    </div>
    <div class="row" style="left: {{x0}}px; top: 108px;" onclick="goColor">
      <div class="rowInner"><text class="rowLabel">自定义颜色</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x1}}px; top: 172px;" onclick="toggleLock">
      <div class="rowInner">
        <text class="rowLabel">锁定当前颜色</text>
        <div class="track" style="background-color: {{lockBg}};"><div class="dot" style="left: {{lockDotX}}px;"></div></div>
      </div>
    </div>
    <div class="row" style="left: {{x2}}px; top: 236px;" onclick="goBright">
      <div class="rowInner"><text class="rowLabel">屏幕亮度</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x3}}px; top: 300px;" onclick="toggleKeep">
      <div class="rowInner">
        <text class="rowLabel">屏幕常亮</text>
        <div class="track" style="background-color: {{swBg}};"><div class="dot" style="left: {{swDotX}}px;"></div></div>
      </div>
    </div>
    <div class="row" style="left: {{x4}}px; top: 364px;" onclick="goAbout">
      <div class="rowInner"><text class="rowLabel">关于</text><text class="rowArrow">›</text></div>
    </div>
    <text if="{{msg}}" class="msg">{{msg}}</text>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
  }
  .titleBar {
    position: absolute;
    width: 336px;
    height: 44px;
  }
  .titleInner {
    width: 336px;
    height: 44px;
    align-items: center;
    justify-content: center;
  }
  .title {
    color: #ffffff;
    font-size: 26px;
  }
  .row {
    position: absolute;
    width: 336px;
    height: 58px;
    align-items: center;
    justify-content: center;
  }
  .rowInner {
    width: 292px;
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .rowLabel {
    color: #ffffff;
    font-size: 23px;
  }
  .rowArrow {
    color: #9a9a9a;
    font-size: 28px;
  }
  .track {
    position: relative;
    width: 68px;
    height: 36px;
    border-radius: 18px;
  }
  .dot {
    position: absolute;
    top: 3px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #ffffff;
  }
  .msg {
    position: absolute;
    left: 0;
    top: 432px;
    width: 336px;
    text-align: center;
    color: #ff6b6b;
    font-size: 15px;
  }
</style>

<script>
  import router from '@system.router';
  import brightness from '@system.brightness';
  import state from '../../common/state.js';

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  export default {
    private: {
      titleX: -336,
      x0: 336,
      x1: 336,
      x2: 336,
      x3: 336,
      x4: 336,
      lockOn: false,
      lockBg: '#4A4A4A',
      lockDotX: 3,
      keepOn: true,
      swBg: '#34C759',
      swDotX: 35,
      msg: ''
    },
    onInit() {
      this._sx = 0;
      this._sy = 0;
      this._nav = false;
      this._leaving = false;
      this.syncState();
      var that = this;
      setTimeout(function () { that.startList(); }, 30);
    },
    onShow() {
      this._nav = false;
      this._leaving = false;
      this.syncState();
    },
    syncState() {
      this.lockOn = state.lockColor;
      this.lockBg = state.lockColor ? '#34C759' : '#4A4A4A';
      this.lockDotX = state.lockColor ? 35 : 3;
      this.keepOn = state.keepOn;
      this.swBg = state.keepOn ? '#34C759' : '#4A4A4A';
      this.swDotX = state.keepOn ? 35 : 3;
    },
    onTouchStart(e) {
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
    },
    onTouchEnd(e) {
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        this.backAnimated();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    startList() {
      var that = this;
      this.titleX = -336;
      this.x0 = 336;
      this.x1 = 336;
      this.x2 = 336;
      this.x3 = 336;
      this.x4 = 336;
      var t0 = Date.now();
      var step = function () {
        try {
          var t = Date.now() - t0;
          var all = true;
          var tp = t / 320;
          if (tp > 1) { tp = 1; }
          that.titleX = -336 * (1 - easeOut(tp));
          if (tp < 1) { all = false; }
          var starts = [140, 200, 260, 320, 380];
          for (var i = 0; i < 5; i++) {
            var p = (t - starts[i]) / 280;
            if (p < 0) { p = 0; }
            if (p > 1) { p = 1; }
            var x = 336 * (1 - easeOut(p));
            if (i === 0) { that.x0 = x; }
            if (i === 1) { that.x1 = x; }
            if (i === 2) { that.x2 = x; }
            if (i === 3) { that.x3 = x; }
            if (i === 4) { that.x4 = x; }
            if (p < 1) { all = false; }
          }
          if (!all) { that._listT = setTimeout(step, 16); }
        } catch (e) {}
      };
      step();
    },
    backAnimated() {
      if (this._leaving) { return; }
      this._leaving = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        try {
          var p = (Date.now() - t0) / 280;
          if (p > 1) { p = 1; }
          var e = easeOut(p);
          that.titleX = -336 * e;
          that.x0 = 336 * e;
          that.x1 = 336 * e;
          that.x2 = 336 * e;
          that.x3 = 336 * e;
          that.x4 = 336 * e;
          if (p < 1) {
            that._backT = setTimeout(step, 16);
          } else {
            router.back();
          }
        } catch (err) {
          router.back();
        }
      };
      step();
    },
    goColor() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/color' });
    },
    goBright() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/brightness' });
    },
    goAbout() {
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/about' });
    },
    toggleLock() {
      state.lockColor = !state.lockColor;
      this.syncState();
    },
    toggleKeep() {
      var that = this;
      var target = !state.keepOn;
      try {
        brightness.setKeepScreenOn({
          keepScreenOn: target,
          success: function () {
            state.keepOn = target;
            that.syncState();
            that.msg = '';
          },
          fail: function () {
            that.msg = '常亮接口不可用';
          }
        });
      } catch (e) {
        this.msg = '常亮接口不可用';
      }
    }
  };
</script>