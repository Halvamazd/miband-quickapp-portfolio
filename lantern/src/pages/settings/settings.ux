<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="titleBar" style="left: {{titleX}}px; top: 40px;">
      <div class="titleInner"><text class="title">设置</text></div>
    </div>
    <div class="row" style="left: {{x0}}px; top: 100px;" onclick="goColor">
      <div class="rowInner"><text class="rowLabel">自定义颜色</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x1}}px; top: 158px;" onclick="toggleLock">
      <div class="rowInner">
        <text class="rowLabel">锁定当前颜色</text>
        <div class="track" style="background-color: {{lockBg}};"><div class="dot" style="left: {{lockDotX}}px;"></div></div>
      </div>
    </div>
    <div class="row" style="left: {{x2}}px; top: 216px;" onclick="goBright">
      <div class="rowInner"><text class="rowLabel">屏幕亮度</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x3}}px; top: 274px;" onclick="toggleKeep">
      <div class="rowInner">
        <text class="rowLabel">屏幕常亮</text>
        <div class="track" style="background-color: {{swBg}};"><div class="dot" style="left: {{swDotX}}px;"></div></div>
      </div>
    </div>
    <div class="row" style="left: {{x4}}px; top: 332px;" onclick="goPrefs">
      <div class="rowInner"><text class="rowLabel">偏好设置</text><text class="rowArrow">›</text></div>
    </div>
    <div class="row" style="left: {{x5}}px; top: 390px;" onclick="goAbout">
      <div class="rowInner"><text class="rowLabel">关于</text><text class="rowArrow">›</text></div>
    </div>
    <text if="{{msg}}" class="msg">{{msg}}</text>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
  }
  .titleBar {
    position: absolute;
    width: 336px;
    height: 44px;
  }
  .titleInner {
    width: 336px;
    height: 44px;
    align-items: center;
    justify-content: center;
  }
  .title {
    color: #ffffff;
    font-size: 30px;
  }
  .row {
    position: absolute;
    width: 336px;
    height: 56px;
    align-items: center;
    justify-content: center;
  }
  .rowInner {
    width: 292px;
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .rowLabel {
    color: #ffffff;
    font-size: 27px;
  }
  .rowArrow {
    color: #9a9a9a;
    font-size: 30px;
  }
  .track {
    position: relative;
    width: 68px;
    height: 36px;
    border-radius: 18px;
  }
  .dot {
    position: absolute;
    top: 3px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #ffffff;
  }
  .msg {
    position: absolute;
    left: 0;
    top: 454px;
    width: 336px;
    text-align: center;
    color: #ff6b6b;
    font-size: 17px;
  }
</style>

<script>
  import router from '@system.router';
  import brightness from '@system.brightness';

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  export default {
    private: {
      titleX: -336,
      x0: 336,
      x1: 336,
      x2: 336,
      x3: 336,
      x4: 336,
      x5: 336,
      lockOn: false,
      lockBg: '#4A4A4A',
      lockDotX: 3,
      keepOn: true,
      swBg: '#34C759',
      swDotX: 35,
      msg: ''
    },
    onInit() {
      this._local = { lockColor: false, keepOn: true, lastHue: 0, pendingColor: '', autoMaxBright: true, autoColorLock: true, ecoMode: false };
      this._nav = false;
      this._leaving = false;
      this._animDone = false;
      this._firstShow = true;
      this._settled = false;
      this.syncState();
      var that = this;
      if (this.isEco()) {
        this.finishListAnim();
      } else {
        setTimeout(function () { that.startList(); }, 30);
      }
    },
    onShow() {
      this._settled = false;
      var that0 = this;
      try { if (this._settleT) { clearTimeout(this._settleT); } } catch (e0) {}
      var ecoNow = this.isEco();
      this._settleT = setTimeout(function () { that0._settled = true; }, ecoNow ? 0 : 380);
      this._nav = false;
      this._leaving = false;
      this.syncState();
      if (this._firstShow) { this._firstShow = false; } else { this.finishListAnim(); }
    },
    onHide() {
      try { if (this._settleT) { clearTimeout(this._settleT); } } catch (e0) {}
      this.finishListAnim();
    },
    finishListAnim() {
      try { if (this._listT) { clearTimeout(this._listT); this._listT = null; } } catch (e) {}
      this.titleX = 0;
      this.x0 = 0;
      this.x1 = 0;
      this.x2 = 0;
      this.x3 = 0;
      this.x4 = 0;
      this.x5 = 0;
      this._animDone = true;
    },
    onBackPress() {
      if (!this._settled) { return true; }
      if (!this._animDone) { this.finishListAnim(); }
      this.backAnimated();
      return true;
    },
    getS() {
      try {
        var d = this.$app.$def.data;
        if (!d.lantern) {
          d.lantern = { lockColor: false, keepOn: true, lastHue: 0, pendingColor: '', autoMaxBright: true, autoColorLock: true, ecoMode: false };
        }
        return d.lantern;
      } catch (e) {
        return this._local;
      }
    },
    isEco() {
      var S = this.getS();
      return S && S.ecoMode === true;
    },
    syncState() {
      var S = this.getS();
      this.lockOn = S.lockColor;
      this.lockBg = S.lockColor ? '#34C759' : '#4A4A4A';
      this.lockDotX = S.lockColor ? 35 : 3;
      this.keepOn = S.keepOn;
      this.swBg = S.keepOn ? '#34C759' : '#4A4A4A';
      this.swDotX = S.keepOn ? 35 : 3;
    },
    onTouchStart(e) {
      if (!this._settled) { return; }
      this._sx = this.getPoint(e).clientX;
      this._sy = this.getPoint(e).clientY;
    },
    onTouchEnd(e) {
      if (!this._settled) { return; }
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        this.backAnimated();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    startList() {
      var that = this;
      this.titleX = -336;
      this.x0 = 336;
      this.x1 = 336;
      this.x2 = 336;
      this.x3 = 336;
      this.x4 = 336;
      this.x5 = 336;
      var t0 = Date.now();
      var step = function () {
        try {
          var t = Date.now() - t0;
          var all = true;
          var tp = t / 320;
          if (tp > 1) { tp = 1; }
          that.titleX = -336 * (1 - easeOut(tp));
          if (tp < 1) { all = false; }
          var starts = [120, 175, 230, 285, 340, 395];
          for (var i = 0; i < 6; i++) {
            var p = (t - starts[i]) / 280;
            if (p < 0) { p = 0; }
            if (p > 1) { p = 1; }
            var x = 336 * (1 - easeOut(p));
            if (i === 0) { that.x0 = x; }
            if (i === 1) { that.x1 = x; }
            if (i === 2) { that.x2 = x; }
            if (i === 3) { that.x3 = x; }
            if (i === 4) { that.x4 = x; }
            if (i === 5) { that.x5 = x; }
            if (p < 1) { all = false; }
          }
          if (!all) { that._listT = setTimeout(step, 16); } else { that._animDone = true; }
        } catch (e) {}
      };
      step();
    },
    backAnimated() {
      if (!this._animDone) { this.finishListAnim(); }
      if (this._leaving) { return; }
      if (this.isEco()) { router.back(); return; }
      this._leaving = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        try {
          var p = (Date.now() - t0) / 280;
          if (p > 1) { p = 1; }
          var e = easeOut(p);
          that.titleX = -336 * e;
          that.x0 = 336 * e;
          that.x1 = 336 * e;
          that.x2 = 336 * e;
          that.x3 = 336 * e;
          that.x4 = 336 * e;
          that.x5 = 336 * e;
          if (p < 1) {
            that._backT = setTimeout(step, 16);
          } else {
            router.back();
          }
        } catch (err) {
          router.back();
        }
      };
      step();
    },
    goColor() {
      if (!this._settled) { return; }
      if (!this._animDone) { this.finishListAnim(); }
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/color' });
    },
    goBright() {
      if (!this._settled) { return; }
      if (!this._animDone) { this.finishListAnim(); }
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/brightness' });
    },
    goPrefs() {
      if (!this._settled) { return; }
      if (!this._animDone) { this.finishListAnim(); }
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/preferences' });
    },
    goAbout() {
      if (!this._settled) { return; }
      if (!this._animDone) { this.finishListAnim(); }
      if (this._nav) { return; }
      this._nav = true;
      router.push({ uri: '/pages/about' });
    },
    toggleLock() {
      var S = this.getS();
      S.lockColor = !S.lockColor;
      this.syncState();
    },
    toggleKeep() {
      var that = this;
      var S = this.getS();
      var target = !S.keepOn;
      try {
        brightness.setKeepScreenOn({
          keepScreenOn: target,
          success: function () {
            S.keepOn = target;
            that.syncState();
            that.msg = '';
          },
          fail: function () {
            that.msg = '常亮接口不可用';
          }
        });
      } catch (e) {
        this.msg = '常亮接口不可用';
      }
    }
  };
</script>