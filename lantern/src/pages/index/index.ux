<template>
  <div class="root" style="background-color: {{bgColor}};" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <div if="{{ballOn}}" class="ball" style="left: {{bx}}px; top: {{by}}px; width: {{bw}}px; height: {{bw}}px; background-color: {{ballColor}};"></div>
    <text if="{{showHint}}" class="hint">点击</text>
    <div if="{{maskOn}}" class="mask" style="left: {{mx}}px; top: {{my}}px; width: {{mr2}}px; height: {{mr2}}px;"></div>
  </div>
</template>

<style>
  .root {
    position: relative;
    width: 336px;
    height: 480px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
  }
  .ball {
    position: absolute;
    border-radius: 50%;
  }
  .hint {
    color: #ffffff;
    font-size: 18px;
  }
  .mask {
    position: absolute;
    border-radius: 50%;
    background-color: #000000;
  }
</style>

<script>
  import vibrator from '@system.vibrator';
  import router from '@system.router';

  var SCREEN_W = 336;
  var SCREEN_H = 480;
  var ENTER_MS = 160;
  var PAUSE_MS = 180;
  var GROW_MS = 620;
  var START_R = 20;
  var MAX_R = 650;
  var STEP_MS = 16;
  var MASK_MS = 460;

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  function easeEnter(t) {
    var c1 = 1.70158;
    var c3 = c1 + 1;
    var u = t - 1;
    return 1 + c3 * u * u * u + c1 * u * u;
  }

  function hex2(n) {
    var s = n.toString(16);
    if (s.length < 2) { s = '0' + s; }
    return s;
  }

  function hslToRgb(h, s, l) {
    h = h % 360;
    if (h < 0) { h += 360; }
    s = s / 100;
    l = l / 100;
    var c = (1 - Math.abs(2 * l - 1)) * s;
    var x = c * (1 - Math.abs((h / 60) % 2 - 1));
    var m = l - c / 2;
    var r = 0;
    var g = 0;
    var b = 0;
    if (h < 60) { r = c; g = x; b = 0; }
    else if (h < 120) { r = x; g = c; b = 0; }
    else if (h < 180) { r = 0; g = c; b = x; }
    else if (h < 240) { r = 0; g = x; b = c; }
    else if (h < 300) { r = x; g = 0; b = c; }
    else { r = c; g = 0; b = x; }
    var R = Math.round((r + m) * 255);
    var G = Math.round((g + m) * 255);
    var B = Math.round((b + m) * 255);
    return '#' + hex2(R) + hex2(G) + hex2(B);
  }

  export default {
    private: {
      bgColor: '#000000',
      showHint: true,
      ballOn: false,
      bx: 0,
      by: 0,
      bw: 0,
      ballColor: '#ffd166',
      maskOn: false,
      mx: 0,
      my: 0,
      mr2: 0
    },
    onInit() {
      this._hue = 0;
      this._navLock = false;
      this._lastTap = 0;
      this._lpFired = false;
      this._moved = false;
    },
    onShow() {
      this._navLock = false;
      this._lpFired = false;
      this._moved = false;
      this._playing = false;
      this.ballOn = false;
      this.maskOn = false;
    },
    onHide() {
      this.finishNow();
    },
    onDestroy() {
      this.finishNow();
    },
    onTouchStart(e) {
      this._t0 = Date.now();
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
      this._moved = false;
      this._lpFired = false;
      if (this._navLock || this._playing) { return; }
      var that = this;
      this._lp = setTimeout(function () {
        try {
          if (!that._moved && !that._navLock) {
            that._lpFired = true;
            that.goSettings();
          }
        } catch (lpErr) {}
      }, 650);
    },
    onTouchMove(e) {
      var p = this.getPoint(e);
      if (Math.abs(p.clientX - this._sx) > 10 || Math.abs(p.clientY - this._sy) > 10) {
        this._moved = true;
        this.clearLp();
      }
    },
    onTouchEnd(e) {
      this.clearLp();
      if (this._lpFired) { this._lpFired = false; return; }
      if (this._moved) { return; }
      if (this._navLock || this._playing) { return; }
      var dt = Date.now() - this._t0;
      if (dt >= 300) { return; }
      var now = Date.now();
      if (now - this._lastTap < 250) { return; }
      this._lastTap = now;
      var p = this.getPoint(e);
      this.tap(p.clientX, p.clientY);
    },
    clearLp() {
      try {
        if (this._lp) { clearTimeout(this._lp); this._lp = null; }
      } catch (cErr) {}
    },
    goSettings() {
      if (this._navLock) { return; }
      this._navLock = true;
      try { vibrator.vibrate({ mode: 'short' }); } catch (v) {}
      var that = this;
      var lit = this.bgColor !== '#000000';
      if (!lit) {
        router.push({ uri: '/pages/settings' });
        return;
      }
      var t0 = Date.now();
      this.maskOn = true;
      var x0 = 0;
      var y0 = SCREEN_H;
      var rMax = 660;
      var stepMask = function () {
        try {
          var p = (Date.now() - t0) / MASK_MS;
          if (p > 1) { p = 1; }
          var r = rMax * easeOut(p);
          that.mx = x0 - r;
          that.my = y0 - r;
          that.mr2 = r * 2;
          if (p < 1) {
            that._maskT = setTimeout(stepMask, 16);
          } else {
            router.push({ uri: '/pages/settings' });
          }
        } catch (e) {
          router.push({ uri: '/pages/settings' });
        }
      };
      stepMask();
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    finishNow() {
      try {
        if (this._timer) { clearTimeout(this._timer); this._timer = null; }
        if (this._maskT) { clearTimeout(this._maskT); this._maskT = null; }
        this.clearLp();
        if (this._anim && this._anim.state === 'grow') {
          this.bgColor = this._anim.color;
        }
        this._anim = null;
        this._playing = false;
        this.ballOn = false;
      } catch (e) {}
    },
    tap(x, y) {
      try {
        if (this._playing) { return; }
        this.showHint = false;
        try { vibrator.vibrate({ mode: 'short' }); } catch (err) {}
        var rMax = Math.min(Math.sqrt(
          Math.max(x * x + y * y, (SCREEN_W - x) * (SCREEN_W - x) + y * y, x * x + (SCREEN_H - y) * (SCREEN_H - y), (SCREEN_W - x) * (SCREEN_W - x) + (SCREEN_H - y) * (SCREEN_H - y))
        ) + 3, MAX_R);
        if (!this._hue) { this._hue = Math.random() * 360; }
        this._hue = (this._hue + 137.5 + Math.random() * 40) % 360;
        var color = hslToRgb(this._hue, 90, 57);
        this.ballColor = color;
        this.bx = x - START_R;
        this.by = y - START_R;
        this.bw = START_R * 2;
        this.ballOn = true;
        this._anim = { x: x, y: y, r: START_R, rMax: rMax, color: color, state: 'enter', t0: Date.now() };
        this._playing = true;
        var that = this;
        var step = function () {
          try {
            var a = that._anim;
            if (!a) { return; }
            var now = Date.now();
            var t = now - a.t0;
            if (a.state === 'enter') {
              var p1 = t / ENTER_MS;
              if (p1 > 1) { p1 = 1; }
              a.r = START_R * easeEnter(p1);
              if (p1 >= 1) { a.state = 'pause'; a.t0 = now; }
            } else if (a.state === 'pause') {
              a.r = START_R;
              if (t >= PAUSE_MS) { a.state = 'grow'; a.t0 = now; }
            } else if (a.state === 'grow') {
              var p2 = t / GROW_MS;
              if (p2 > 1) { p2 = 1; }
              a.r = START_R + (a.rMax - START_R) * easeOut(p2);
              if (p2 >= 1) {
                that.bgColor = a.color;
                that.ballOn = false;
                that._anim = null;
                that._playing = false;
                that._timer = null;
                return;
              }
            }
            that.bw = a.r * 2;
            that.bx = a.x - a.r;
            that.by = a.y - a.r;
            that._timer = setTimeout(step, STEP_MS);
          } catch (err2) {
            that.finishNow();
          }
        };
        this._timer = setTimeout(step, 0);
      } catch (err3) {}
    }
  };
</script>