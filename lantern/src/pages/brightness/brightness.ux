<template>
  <div class="root" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <div class="wrap" style="left: {{shift}}px;">
      <text class="title">屏幕亮度</text>
      <div class="barZone">
        <div class="bar">
          <div class="fill" style="height: {{fillH}}px;"></div>
          <div class="sun">
            <div class="core"></div>
            <div class="ray rayT"></div>
            <div class="ray rayB"></div>
            <div class="ray rayL"></div>
            <div class="ray rayR"></div>
          </div>
        </div>
      </div>
      <text if="{{msg}}" class="msg">{{msg}}</text>
    </div>
  </div>
</template>

<style>
  .root {
    width: 336px;
    height: 480px;
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }
  .wrap {
    position: absolute;
    top: 0;
    width: 336px;
    height: 480px;
  }
  .title {
    position: absolute;
    left: 0;
    top: 40px;
    width: 336px;
    text-align: center;
    color: #ffffff;
    font-size: 28px;
  }
  .barZone {
    position: absolute;
    left: 0;
    top: 100px;
    width: 336px;
    height: 330px;
    align-items: center;
    justify-content: center;
  }
  .bar {
    position: relative;
    width: 72px;
    height: 330px;
    border-radius: 36px;
    background-color: #3a3a3a;
  }
  .fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 72px;
    border-radius: 36px;
    background-color: #ffffff;
  }
  .sun {
    position: absolute;
    left: 0;
    bottom: 10px;
    width: 72px;
    height: 28px;
  }
  .core {
    position: absolute;
    left: 30px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #3a3a3a;
  }
  .ray {
    position: absolute;
    background-color: #3a3a3a;
    border-radius: 1px;
  }
  .rayT {
    left: 34px;
    top: 0;
    width: 3px;
    height: 6px;
  }
  .rayB {
    left: 34px;
    bottom: 0;
    width: 3px;
    height: 6px;
  }
  .rayL {
    left: 22px;
    top: 13px;
    width: 6px;
    height: 3px;
  }
  .rayR {
    right: 22px;
    top: 13px;
    width: 6px;
    height: 3px;
  }
  .msg {
    position: absolute;
    left: 0;
    top: 438px;
    width: 336px;
    text-align: center;
    color: #ff6b6b;
    font-size: 17px;
  }
</style>

<script>
  import router from '@system.router';
  import brightness from '@system.brightness';

  var TOP = 100;
  var HEIGHT = 330;

  function easeOut(t) {
    var u = 1 - t;
    return 1 - u * u * u;
  }

  export default {
    private: {
      shift: 336,
      val: 200,
      fillH: 259,
      msg: ''
    },
    onInit() {
      this._sx = 0;
      this._sy = 0;
      this._drag = false;
      this._leaving = false;
      var that = this;
      setTimeout(function () {
        that.slideIn();
      }, 30);
    },
    slideIn() {
      var that = this;
      var t0 = Date.now();
      var step = function () {
        var p = (Date.now() - t0) / 300;
        if (p > 1) { p = 1; }
        that.shift = 336 * (1 - easeOut(p));
        if (p < 1) { that._inT = setTimeout(step, 16); }
      };
      step();
    },
    syncCurrent() {
      var that = this;
      this._syncTry = 0;
      var read = function () {
        try {
          brightness.getValue({
            success: function (res) {
              try {
                var raw = res && res.value;
                if (raw === undefined || raw === null || raw === '') { return; }
                var v = Number(raw);
                if (isFinite(v)) {
                  v = Math.round(v);
                  if (v < 0) { v = 0; }
                  if (v > 255) { v = 255; }
                  if (that._drag) { return; }
                  that.val = v;
                  that.fillH = HEIGHT * v / 255;
                }
              } catch (e2) {}
            },
            fail: function () {
              if (that._syncTry < 2) {
                that._syncTry++;
                that._syncT = setTimeout(read, 120);
              }
            }
          });
        } catch (e) {}
      };
      try {
        brightness.getMode({
          success: function (res) {
            var m = res && res.mode;
            that.autoMode = (m === 1);
            read();
          },
          fail: read
        });
      } catch (e) {
        read();
      }
    },
    onShow() {
      this._settled = false;
      var that0 = this;
      try { if (this._settleT) { clearTimeout(this._settleT); } } catch (e0) {}
      try { if (this._syncT) { clearTimeout(this._syncT); } } catch (e1) {}
      this._settleT = setTimeout(function () { that0._settled = true; }, 380);
      setTimeout(function () { that0.syncCurrent(); }, 40);
    },
    onBackPress() {
      if (!this._settled) { return true; }
      this.backAnimated();
      return true;
    },
    onDestroy() {
      try {
        if (this._inT) { clearTimeout(this._inT); }
        if (this._outT) { clearTimeout(this._outT); }
        if (this._syncT) { clearTimeout(this._syncT); }
      } catch (e) {}
    },
    onTouchStart(e) {
      if (!this._settled) { return; }
      var p = this.getPoint(e);
      this._sx = p.clientX;
      this._sy = p.clientY;
      if (p.clientX >= 100 && p.clientX <= 236 && p.clientY >= TOP - 10 && p.clientY <= TOP + HEIGHT + 10) {
        this._drag = true;
        this.setByY(p.clientY);
      }
    },
    onTouchMove(e) {
      if (!this._drag) { return; }
      var p = this.getPoint(e);
      this.setByY(p.clientY);
    },
    onTouchEnd(e) {
      if (!this._settled) { return; }
      if (this._drag) {
        this._drag = false;
        this.apply();
        return;
      }
      var p = this.getPoint(e);
      var dx = p.clientX - this._sx;
      var dy = Math.abs(p.clientY - this._sy);
      if (dx > 65 && dy < 90) {
        this.backAnimated();
      }
    },
    getPoint(e) {
      try {
        if (e && e.touches && e.touches.length > 0) { return e.touches[0]; }
        if (e && e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }
        if (e && typeof e.clientX === 'number') { return e; }
      } catch (err) {}
      return { clientX: 168, clientY: 240 };
    },
    backAnimated() {
      if (!this._settled) { return; }
      if (this._leaving) { return; }
      this._leaving = true;
      var that = this;
      var t0 = Date.now();
      var step = function () {
        try {
          var p = (Date.now() - t0) / 260;
          if (p > 1) { p = 1; }
          that.shift = 336 * easeOut(p);
          if (p < 1) {
            that._outT = setTimeout(step, 16);
          } else {
            router.back();
          }
        } catch (e) {
          router.back();
        }
      };
      step();
    },
    setByY(y) {
      var v = (TOP + HEIGHT - y) / HEIGHT * 255;
      if (v < 0) { v = 0; }
      if (v > 255) { v = 255; }
      v = Math.round(v);
      this.val = v;
      this.fillH = HEIGHT * v / 255;
      this.msg = '';
    },
    apply() {
      var that = this;
      var setV = function () {
        try {
          brightness.setValue({
            value: that.val,
            success: function () { that.msg = ''; },
            fail: function () { that.msg = '亮度接口不可用'; }
          });
        } catch (e) {
          that.msg = '亮度接口不可用';
        }
      };
      try {
        brightness.getMode({
          success: function (res) {
            var m = res && res.mode;
            if (m === 0) {
              setV();
            } else {
              brightness.setMode({
                mode: 0,
                success: function () { setTimeout(setV, 30); },
                fail: setV
              });
            }
          },
          fail: setV
        });
      } catch (e) {
        setV();
      }
    }
  };
</script>